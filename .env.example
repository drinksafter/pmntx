# PMNTX environment variables — variable names and safe placeholders only.
# Copy to .env.local and fill in real values. Never commit .env.local.
# See README.md for what each variable does and where to obtain it.

# ---- Bootstrap (required before the app runs at all) ----------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key, base64-encoded, used to encrypt integration credentials at
# rest (AES-256-GCM). Generate with: openssl rand -base64 32
PMNTX_MASTER_ENCRYPTION_KEY=

# Public URL this app is deployed at (used for auth email redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- In-app managed credentials --------------------------------------------
# Everything below this line is configured through Admin → System →
# Integrations once the app is running, NOT through environment variables.
# Listed here only so the full set of external services is visible in one
# place. Do not set these as env vars — see docs/ADMIN_INTEGRATIONS.md.
#
#   Quiver Quantitative   (alternative data)
#   Market data provider  (daily OHLCV / reference pricing)
#   SEC EDGAR             (filings — no credential required, rate-limited)
#   FRED / ALFRED         (macro data)
#   OpenAI                (AI provider)
#   Anthropic             (AI provider)
#   Telnyx                (AI inference; voice architecture only in Phase 1A)
